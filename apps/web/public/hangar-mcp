#!/usr/bin/env python3
"""hangar-mcp - connect an AI assistant to Hangar over MCP.

Install (from your own Hangar, so the URL is always right):

    curl -fsSL https://hangar.getdumont.ai/hangar-mcp -o ~/.local/bin/hangar-mcp
    chmod +x ~/.local/bin/hangar-mcp

Then point any MCP client at it:

    command: hangar-mcp
    env:     HANGAR_API_KEY=<your token>              (Settings -> API tokens)
             HANGAR_URL=https://hangar.getdumont.ai   (optional, this is the default)
             HANGAR_WORKSPACE=dumont                  (optional, this is the default)

It runs the work item MCP server underneath and relays stdio both ways, rewriting
the one field where the server names itself so clients show "Hangar".
"""

import json
import os
import shutil
import subprocess
import sys
import threading

DEFAULT_URL = "https://hangar.getdumont.ai"
DEFAULT_WORKSPACE = "dumont"
SERVER_NAME = "Hangar"

api_key = os.environ.get("HANGAR_API_KEY") or os.environ.get("HANGAR_TOKEN")
if not api_key:
    sys.exit(
        "hangar-mcp: no token. Create one in Hangar under your avatar -> Settings -> API tokens, "
        "then set HANGAR_API_KEY in your MCP config."
    )

runner = shutil.which("uvx")
if not runner:
    sys.exit(
        "hangar-mcp: uvx is missing. Install uv first:\n"
        "  brew install uv\n"
        "  or: curl -LsSf https://astral.sh/uv/install.sh | sh"
    )

environment = {
    **os.environ,
    "PLANE_API_KEY": api_key,
    "PLANE_BASE_URL": os.environ.get("HANGAR_URL", DEFAULT_URL).rstrip("/"),
    "PLANE_WORKSPACE_SLUG": os.environ.get("HANGAR_WORKSPACE", DEFAULT_WORKSPACE),
}

# no version pin: bug fixes ride along. Pin here if an upstream release ever breaks us.
server = subprocess.Popen(
    [runner, "plane-mcp-server", "stdio", *sys.argv[1:]],
    stdin=subprocess.PIPE,
    stdout=subprocess.PIPE,
    env=environment,
    bufsize=0,
)


def rename(line: bytes) -> bytes:
    """Only the initialize response carries serverInfo; everything else passes through."""
    if b'"serverInfo"' not in line:
        return line
    try:
        message = json.loads(line)
        info = message.get("result", {}).get("serverInfo")
        if isinstance(info, dict):
            info["name"] = SERVER_NAME
            return (json.dumps(message) + "\n").encode()
    except (ValueError, AttributeError):
        pass
    return line


def pump(source, sink, transform=None):
    for line in iter(source.readline, b""):
        sink.write(transform(line) if transform else line)
        sink.flush()
    sink.close()


threading.Thread(
    target=pump, args=(sys.stdin.buffer, server.stdin), daemon=True
).start()
pump(server.stdout, sys.stdout.buffer, rename)
sys.exit(server.wait())
