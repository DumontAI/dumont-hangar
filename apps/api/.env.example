# Backend
# Debug value for api server use it as 0 for production use
DEBUG=0
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100"

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://localhost:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# Settings related to Docker
DOCKERIZED=1 # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=0



# Email redirections and minio domain settings
WEB_URL="http://localhost:8000"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Base URLs
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# Hard delete files after days
HARD_DELETE_AFTER_DAYS=60

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# Dumont: accept Dumont Auth (ZITADEL) access tokens as `Authorization: Bearer` on API v1
# (plane/dumont/auth, operator notes in plane/dumont/auth/README.md). Off by default.
# When "1", DUMONT_API_AUDIENCES and DUMONT_ZITADEL_ORG_ID are required, and every
# container that loads this file (api, worker, beat-worker, migrator) refuses to start if the
# config is invalid, because they all load Django settings. Users must have signed in once
# with Dumont login. When "0"/unset, all other DUMONT_API_* values are ignored.
DUMONT_API_BEARER_ENABLED=0
# Comma-separated ZITADEL project ids accepted in the token `aud` (the Hangar MCP audience).
DUMONT_API_AUDIENCES=
# The Dumont ZITADEL organization id whose role grants count. Bare id (no ':' or whitespace).
# Roles granted in any other organization (project grants, shared instance) are ignored.
# Also used by the ZITADEL membership sync (DUMONT_ACCESS_*), so one value governs both.
DUMONT_ZITADEL_ORG_ID=
# Issuer and JWKS default to DUMONT_AUTH_HOST and ${DUMONT_AUTH_HOST}/oauth/v2/keys (same origin required).
# DUMONT_AUTH_HOST=https://auth.getdumont.ai
# DUMONT_AUTH_ISSUER=
# DUMONT_AUTH_JWKS_URL=
# DUMONT_API_READER_ROLE=hangar_reader
# DUMONT_API_WRITER_ROLE=hangar_writer
# Per-user (ZITADEL sub) rate limit for bearer requests; defaults to API_KEY_RATE_LIMIT.
# DUMONT_API_BEARER_RATE_LIMIT=60/minute
# Opaque (non-JWT) access tokens via RFC 7662 introspection, client_secret_basic. On only when both
# the client id and secret are set (one without the other refuses to start). Without them, opaque
# tokens get 401. The URL defaults to ${DUMONT_AUTH_HOST}/oauth/v2/introspect (same origin as the issuer).
# DUMONT_API_INTROSPECTION_URL=
# DUMONT_API_INTROSPECTION_CLIENT_ID=
# DUMONT_API_INTROSPECTION_CLIENT_SECRET=
# Dumont web login organization check (off by default). "1": only users of DUMONT_ZITADEL_ORG_ID can
# sign in with Dumont login (claim urn:zitadel:iam:user:resourceowner:id); login time only, other
# login methods and existing sessions/API tokens are not affected. Anything but 1/0/unset, or 1
# without a valid DUMONT_ZITADEL_ORG_ID, refuses every Dumont login. See docs/dumont/zitadel-access.md.
DUMONT_WEB_LOGIN_ORG_CHECK=0

# Dumont: workspace/project memberships managed as ZITADEL role grants (plane/dumont/access,
# operator notes in docs/dumont/zitadel-access.md). Off by default: off | dry-run | enforce.
# dry-run and enforce need DUMONT_ZITADEL_ORG_ID (above) and the variables below.
DUMONT_ACCESS_SYNC=off
# Workspace slug the roles hangar.workspace.* refer to, e.g. dumont.
DUMONT_ACCESS_WORKSPACE_SLUG=
# ZITADEL project holding the hangar.* roles (the Hangar MCP audience project).
DUMONT_ACCESS_ZITADEL_PROJECT_ID=
# Read-only ZITADEL service user key (JSON content, or a path to the file). Secret: keep it in the
# vault, never in git.
DUMONT_ACCESS_ZITADEL_KEY_JSON=
# Safety brake: a full sync that would remove or reduce the access of more users than this writes nothing.
# DUMONT_ACCESS_MAX_REMOVALS=5
