{
  "name": "hangar-mcp-server",
  "version": "0.3.0",
  "private": true,
  "description": "MCP server for the Dumont Hangar (Plane) instance: reads plus role-gated writes, acting as the logged-in user",
  "bin": {
    "hangar-mcp-http": "dist/http.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "type-check": "npm run typecheck",
    "test": "vitest run",
    "start": "node dist/http.js",
    "start:http": "node dist/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "jose": "^6.2.12",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2"
}
