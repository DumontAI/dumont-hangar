# Hangar (Plane) read-only MCP server.
# HANGAR_API_KEY is a dedicated server-side bot token for upstream reads.
# Clients authenticate to this MCP only through ZITADEL OIDC.
HANGAR_BASE_URL=https://hangar.getdumont.ai
HANGAR_API_KEY=
HANGAR_WORKSPACE_SLUG=
# CSV of project identifiers (like HGR) or project UUIDs this server may read.
HANGAR_ALLOWED_PROJECTS=
HANGAR_TIMEOUT_MS=7500
HANGAR_MAX_RESPONSE_BYTES=2097152
HANGAR_MAX_SEARCH_PAGES=3
HANGAR_PROJECT_CACHE_SECONDS=60

MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3014
MCP_AUTH_MODE=oidc
MCP_RESOURCE_URL=https://hangar.getdumont.ai/mcp
MCP_OIDC_ISSUER=https://auth.getdumont.ai
MCP_OIDC_JWKS_URL=https://auth.getdumont.ai/oauth/v2/keys
MCP_OIDC_AUDIENCE=
MCP_OIDC_REQUIRED_ROLE=hangar_reader
# Defaults to the ZITADEL role scope for MCP_OIDC_REQUIRED_ROLE.
MCP_OIDC_REQUIRED_SCOPE=
MCP_OIDC_ALLOWED_ORG_ID=
# Comma-separated. Leave MCP_OIDC_ALLOWED_SUBJECTS empty to allow every subject
# that carries the required role. Limits a token to specific ZITADEL subjects.
MCP_OIDC_ALLOWED_SUBJECTS=
MCP_ALLOWED_HOSTS=hangar.getdumont.ai,127.0.0.1,localhost
MCP_ALLOWED_ORIGINS=

# Optional RFC 7662 introspection for opaque ZITADEL access tokens (DCR clients).
# Credentials of a ZITADEL API app in the same project as MCP_OIDC_AUDIENCE:
# exactly one of MCP_OIDC_INTROSPECTION_CLIENT_SECRET or the JSON key file.
MCP_OIDC_INTROSPECTION_URL=
MCP_OIDC_INTROSPECTION_CLIENT_ID=
MCP_OIDC_INTROSPECTION_CLIENT_SECRET=
MCP_OIDC_INTROSPECTION_PRIVATE_KEY_JSON=
MCP_OIDC_INTROSPECTION_TIMEOUT_MS=3000
MCP_OIDC_INTROSPECTION_CACHE_SECONDS=30
MCP_OIDC_INTROSPECTION_MAX_IN_FLIGHT=8
MCP_OIDC_INTROSPECTION_RATE_PER_SECOND=20
